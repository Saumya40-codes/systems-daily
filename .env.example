# --- LLM ---
# Provider: http (OpenAI-compatible API) or cli (local command, stdout = body)
LLM_PROVIDER=http

# HTTP (default)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2
LLM_API_KEY=ollama
# Examples:
# Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_API_KEY=gsk_...  LLM_MODEL=llama-3.3-70b-versatile
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_API_KEY=sk-or-...
# xAI:        LLM_BASE_URL=https://api.x.ai/v1  LLM_API_KEY=...  LLM_MODEL=grok-4.5

# CLI (optional) - your script/CLI; does not automate websites
# LLM_PROVIDER=cli
# LLM_CLI_CMD=./scripts/agent-llm-cli.sh   # or scripts/example-llm-cli.sh for a smoke test
# LLM_CLI_ARGS=codex exec --ephemeral --ignore-user-config --ignore-rules --skip-git-repo-check --sandbox read-only --color never -
# LLM_CLI_MODEL=                           # optional provenance label; put model-selection flags in LLM_CLI_ARGS
# SYSTEMS_DAILY_AGENT_PROMPT_MODE=stdin    # stdin (default) or arg
# Direct CLI protocol: stdin blocks plus SYSTEMS_DAILY_SYSTEM / SYSTEMS_DAILY_USER env

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=you@gmail.com
SMTP_TO=you@gmail.com

# --- Schedule ---
SEND_AT=09:00
# TIMEZONE=Asia/Kolkata

# --- Content / history ---
# TARGET_WORDS_MIN=700
# TARGET_WORDS_MAX=1200
# HISTORY_PATH=data/history.json
# ARTIFACT_DIR=data/articles
# HISTORY_WINDOW_DAYS=6
# TOPICS_PATH=topics.json

# DRY_RUN=1

# --- Static site ---
SITE_OUT_DIR=site/public
# SITE_BASE_URL=https://your-app.vercel.app
# Or interim ngrok: SITE_BASE_URL=https://xxxx.ngrok-free.app
SITE_WINDOW_DAYS=7
# ATTACH_PDF=0
