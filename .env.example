# --- LLM (OpenAI-compatible) ---
# Default: local Ollama. Any /v1 chat completions endpoint works.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2
LLM_API_KEY=ollama

# Examples:
# Ollama:     LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.2
# LM Studio:  LLM_BASE_URL=http://localhost:1234/v1   LLM_MODEL=...
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_API_KEY=sk-or-...
# xAI:        LLM_BASE_URL=https://api.x.ai/v1  LLM_API_KEY=...  LLM_MODEL=grok-4.5

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=you@gmail.com
SMTP_TO=you@gmail.com
# SMTP_USE_TLS=true
# SMTP_INSECURE=false

# --- Schedule ---
SEND_AT=09:00
# TIMEZONE=Asia/Kolkata

# --- Content / history ---
# TARGET_WORDS_MIN=700
# TARGET_WORDS_MAX=1200
# HISTORY_PATH=data/history.json
# HISTORY_WINDOW_DAYS=60

# DRY_RUN=1   # generate but never send
